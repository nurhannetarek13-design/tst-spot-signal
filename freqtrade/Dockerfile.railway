FROM freqtradeorg/freqtrade:stable

# Railway runtime: NFI + Fast Entry + signed Make relay + front proxy.
# Dynamic sizing preflight: live signals require a successful real free-USDT read.
# Entry quality is fail-closed on microstructure, higher timeframes and BTC regime.
# Telegram callback ownership is Cloudflare-only. Railway may validate outbound
# Telegram access, but must never poll getUpdates or own the webhook.
USER root
WORKDIR /freqtrade

RUN pip install --no-cache-dir cryptography

COPY telegram_signal_bridge.py /freqtrade/telegram_signal_bridge.py
COPY front_proxy.py /freqtrade/front_proxy.py
COPY trade_state.py /freqtrade/trade_state.py
COPY binance_filters.py /freqtrade/binance_filters.py
COPY reconcile_state.py /freqtrade/reconcile_state.py
COPY runtime_bootstrap.sh /freqtrade/runtime_bootstrap.sh
COPY profit_manager.py /freqtrade/profit_manager.py
COPY outcome_engine.py /freqtrade/outcome_engine.py
COPY run_ready_bot.sh /freqtrade/run_ready_bot.sh
COPY fast_entry_engine.py /freqtrade/fast_entry_engine.py
COPY fast_ingest_ecdsa.py /freqtrade/fast_ingest_ecdsa.py
COPY dynamic_sizing.py /freqtrade/dynamic_sizing.py
COPY entry_quality.py /freqtrade/entry_quality.py
COPY new_listing_watcher.py /freqtrade/new_listing_watcher.py
COPY sol_buy_zone_watch.py /freqtrade/sol_buy_zone_watch.py
COPY patch_dynamic_sizing.py /freqtrade/patch_dynamic_sizing.py
COPY patch_momentum_ignition.py /freqtrade/patch_momentum_ignition.py
COPY patch_growth_mode.py /freqtrade/patch_growth_mode.py
COPY patch_new_listing_reservation.py /freqtrade/patch_new_listing_reservation.py
COPY patch_unicode_symbols.py /freqtrade/patch_unicode_symbols.py
COPY patch_stablecoin_exclusions.py /freqtrade/patch_stablecoin_exclusions.py
COPY patch_fast_momentum_discovery.py /freqtrade/patch_fast_momentum_discovery.py
COPY patch_runtime_cleanup.py /freqtrade/patch_runtime_cleanup.py
COPY patch_scoreboard.py /freqtrade/patch_scoreboard.py
COPY patch_adaptive_watch.py /freqtrade/patch_adaptive_watch.py
COPY patch_no_daily_signal_cap.py /freqtrade/patch_no_daily_signal_cap.py
COPY patch_extreme_continuation.py /freqtrade/patch_extreme_continuation.py
COPY patch_tp_execution_tick.py /freqtrade/patch_tp_execution_tick.py
COPY patch_profit_engine_v2.py /freqtrade/patch_profit_engine_v2.py
COPY patch_expert_system_v3.py /freqtrade/patch_expert_system_v3.py
COPY patch_expert_system_v3b.py /freqtrade/patch_expert_system_v3b.py
COPY entrypoint.sh /freqtrade/entrypoint.sh
COPY user_data /freqtrade/user_data

RUN sed -i 's/NFI_MAX_PAIRS = 28/NFI_MAX_PAIRS = 16/' /freqtrade/run_ready_bot.sh \
    && sed -i '/from telegram_signal_bridge import send_prealert/a send_prealert = lambda **kwargs: None' /freqtrade/run_ready_bot.sh \
    && sed -i "s/if python - <<'PY'/if python - 2>\/dev\/null <<'PY'/" /freqtrade/run_ready_bot.sh \
    && sed -i '/import telegram_signal_bridge as bridge/a from fast_ingest_ecdsa import sign_fast_ingest' /freqtrade/fast_entry_engine.py \
    && sed -i "/'X-Fast-Signature': signature,/a\            'X-Fast-ECDSA': sign_fast_ingest(raw, ts)," /freqtrade/fast_entry_engine.py \
    && python /freqtrade/patch_dynamic_sizing.py \
    && python /freqtrade/patch_momentum_ignition.py \
    && python /freqtrade/patch_growth_mode.py \
    && python /freqtrade/patch_new_listing_reservation.py \
    && python /freqtrade/patch_unicode_symbols.py \
    && python /freqtrade/patch_stablecoin_exclusions.py \
    && python /freqtrade/patch_fast_momentum_discovery.py \
    && python /freqtrade/patch_runtime_cleanup.py \
    && python /freqtrade/patch_scoreboard.py \
    && python /freqtrade/patch_adaptive_watch.py \
    && python /freqtrade/patch_no_daily_signal_cap.py \
    && python /freqtrade/patch_extreme_continuation.py \
    && python /freqtrade/patch_tp_execution_tick.py \
    && python /freqtrade/patch_profit_engine_v2.py \
    && python /freqtrade/patch_expert_system_v3b.py \
    && sed -i 's|python -u "$BRIDGE_FILE" \&|sleep infinity \& # Cloudflare owns Telegram webhook; keep placeholder PID only|' /freqtrade/run_ready_bot.sh \
    && python -c 'import sys; sys.path.insert(0,"/freqtrade"); import fast_ingest_ecdsa, dynamic_sizing, entry_quality, fast_entry_engine, new_listing_watcher, sol_buy_zone_watch, trade_state, binance_filters, reconcile_state, profit_manager, outcome_engine; assert str(trade_state.STATE_PATH).startswith("/data/"); assert not fast_entry_engine.symbol_ok("UUSDT"); assert fast_entry_engine.symbol_ok("DOGEUSDT"); assert hasattr(fast_entry_engine,"fast_momentum_candidates"); assert hasattr(fast_entry_engine,"explosive_candidates"); assert hasattr(fast_entry_engine,"extreme_candidates"); assert hasattr(fast_entry_engine,"mid_candidates"); assert hasattr(fast_entry_engine,"score_mid"); assert hasattr(fast_entry_engine,"_normalize_tp_for_execution"); assert hasattr(fast_entry_engine,"_expert_pre_ingest"); assert fast_entry_engine.WATCH_SCORE <= fast_entry_engine.DIRECT_SCORE; assert fast_entry_engine.MID_WATCH_SCORE <= fast_entry_engine.MID_DIRECT_SCORE; assert fast_entry_engine.EXTREME_WATCH_SCORE <= fast_entry_engine.EXTREME_DIRECT_SCORE; assert fast_entry_engine.MIN_SCORE == fast_entry_engine.DIRECT_SCORE; assert fast_entry_engine.GLOBAL_COOLDOWN_SEC == fast_entry_engine.SIGNAL_BURST_GUARD_SEC' \
    && chmod +x /freqtrade/run_ready_bot.sh /freqtrade/entrypoint.sh /freqtrade/runtime_bootstrap.sh \
    && chown -R ftuser:ftuser /freqtrade

# Keep image entry as root only long enough to prepare the Railway-mounted
# persistent volume. runtime_bootstrap immediately chowns /data and execs every
# trading process as ftuser.
USER root
ENV PYTHONUNBUFFERED=1
ENV BRIDGE_PORT=8082
EXPOSE 8080
CMD ["/bin/bash", "/freqtrade/runtime_bootstrap.sh"]
