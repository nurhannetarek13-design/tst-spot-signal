{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tst-spot-signal",
  "main": "src/ops-supervisor.js",
  "compatibility_date": "2026-08-29",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "LIVE_EXECUTION_ENABLED": "false",
    "AUTONOMOUS_ENABLED": "false",
    "E2E_ARMED": "false",
    "MAX_ORDER_USDT": "5.5",
    "MAX_OPEN_POSITIONS": "1",
    "DAILY_LOSS_CAP_USDT": "0.5"
  },
  "durable_objects": {
    "bindings": [
      { "name": "STATE_COORDINATOR", "class_name": "SignalState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalState"] }
  ]
}
