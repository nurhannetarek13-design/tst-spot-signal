{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tst-spot-signal",
  "main": "src/edge-worker.js",
  "compatibility_date": "2026-08-29",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "STATE_COORDINATOR", "class_name": "SignalState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalState"] }
  ]
}
