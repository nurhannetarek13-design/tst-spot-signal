FROM drakkarsoftware/octobot:stable

WORKDIR /octobot

COPY deploy/octobot-paper-bootstrap.py /octobot/octobot-paper-bootstrap.py

# Persistent user volume is initialized; apply the fail-safe paper bootstrap
# before every OctoBot start.
ENTRYPOINT []

# OctoBot standalone web UI.
EXPOSE 5001

CMD ["/bin/bash", "-lc", "python /octobot/octobot-paper-bootstrap.py && exec ./docker-entrypoint.sh"]
