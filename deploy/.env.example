# Copy to deploy/.env on the server. Never commit deploy/.env.

# Required. Generate a long random value on the server.
FUSION_INGEST_TOKEN=

# Keep blank during paper-only operation unless Binance public/private account
# access is intentionally needed by Freqtrade. Live execution remains disabled
# by the repository policy regardless.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Optional Telegram for Freqtrade paper notifications.
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Hummingbot API / Condor credentials are created by the official installer
# and stay in its own .env / encrypted credential store.
