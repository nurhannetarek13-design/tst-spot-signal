FROM python:3.11-slim
WORKDIR /app
COPY research/requirements-forward-collector.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY research/forward_liquidation_collector.py /app/forward_liquidation_collector.py
ENV LIQ_DATA_DIR=/data/forward-liquidations
CMD ["python", "/app/forward_liquidation_collector.py"]
