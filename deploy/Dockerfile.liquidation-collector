FROM python:3.11-slim
WORKDIR /app
COPY research/requirements-forward-collector.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY research/forward_liquidation_collector.py /app/forward_liquidation_collector.py
COPY research/coinalyze_liquidation_history.py /app/coinalyze_liquidation_history.py
COPY research/coinalyze_daily_regime_discovery.py /app/coinalyze_daily_regime_discovery.py
COPY research/binance_vision_extreme_shock_validation.py /app/binance_vision_extreme_shock_validation.py
COPY research/extreme_shock_frozen_oos.py /app/extreme_shock_frozen_oos.py
COPY research/extreme_shock_frozen_multiyear.py /app/extreme_shock_frozen_multiyear.py
COPY research/tradingview_breakout_raw_gate.py /app/tradingview_breakout_raw_gate.py
COPY deploy/liquidation-collector-entrypoint.sh /app/liquidation-collector-entrypoint.sh
RUN chmod +x /app/liquidation-collector-entrypoint.sh
ENV LIQ_DATA_DIR=/data/forward-liquidations
ENV COINALYZE_DATA_DIR=/data/coinalyze-liquidations
ENV COINALYZE_DISCOVERY_DIR=/data/coinalyze-regime-discovery
ENV BINANCE_VISION_SHOCK_DIR=/data/binance-vision-extreme-shocks
ENV FROZEN_OOS_DIR=/data/frozen-extreme-shock-oos
ENV FROZEN_MULTIYEAR_DIR=/data/frozen-extreme-shock-multiyear
ENV TV_BREAKOUT_OUT=/data/tradingview-breakout-raw-gate
CMD ["/app/liquidation-collector-entrypoint.sh"]
