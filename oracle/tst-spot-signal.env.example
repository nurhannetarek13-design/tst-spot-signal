PORT=10000

# Keep false until Binance API + Trusted IP are configured.
LIVE_TRADING=false

# Portfolio settings
TRADE_USDT=5
MAX_OPEN_POSITIONS=3
RESERVE_USDT=2
MAX_RISK_USDT=0.5

# Binance trading API: Spot trading only. Never enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Used only to authenticate signed requests from the Cloudflare Telegram bot.
# Put the same Telegram bot token already used by the Worker here.
TELEGRAM_BOT_TOKEN=
